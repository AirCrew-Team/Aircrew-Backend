{
  "name": "backend-vuelos",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "services/*",
    "shared"
  ],
  "scripts": {
    "start:gateway": "npm run -w @vuelos/gateway start",
    "start:flights": "npm run -w @vuelos/flights start",
    "start:crew": "npm run -w @vuelos/crew start",
    "start:recommendation": "npm run -w @vuelos/recommendation start",
    "start:notification": "npm run -w @vuelos/notification start",
    "start:admin": "npm run -w @vuelos/admin start",
    "dev:gateway": "npm run -w @vuelos/gateway dev",
    "dev:flights": "npm run -w @vuelos/flights dev",
    "dev:crew": "npm run -w @vuelos/crew dev",
    "dev:recommendation": "npm run -w @vuelos/recommendation dev",
    "dev:notification": "npm run -w @vuelos/notification dev",
    "dev:all": "concurrently -k -n admin,crew,flights,recom,notif,gateway -c blue,green,yellow,magenta,cyan,white \"npm:dev:admin\" \"npm:dev:crew\" \"npm:dev:flights\" \"npm:dev:recommendation\" \"npm:dev:notification\" \"npm:dev:gateway\"",
    "start:all": "concurrently -k -n admin,crew,flights,recom,notif,gateway -c blue,green,yellow,magenta,cyan,white \"npm:start:admin\" \"npm:start:crew\" \"npm:start:flights\" \"npm:start:recommendation\" \"npm:start:notification\" \"npm:start:gateway\"",
    "dev:admin": "npm run -w @vuelos/admin dev",
    "seed:demo": "node database/seed-demo.js",
    "test": "node --test \"services/*/test/*.test.js\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
