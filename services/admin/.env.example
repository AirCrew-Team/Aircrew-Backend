PORT=3005
# Solo en producción: la cookie de sesión lleva Secure.
# NODE_ENV=production
DB_HOST=localhost
DB_PORT=5432
DB_NAME=admin_db
DB_USER=postgres
DB_PASSWORD=
# Igual en todos los servicios: Admin firma los tokens y los demás los validan.
JWT_SECRET=
JWT_EXPIRES_IN=1h
# Clave para crear el primer super_admin (header x-bootstrap-key).
SUPER_ADMIN_BOOTSTRAP_KEY=
# Igual que en crew/.env: Crew la usa para pedir cuentas de tripulante.
CREW_SERVICE_KEY=
# Igual que en crew/.env: Admin la usa para crear, editar y desactivar perfiles de tripulante.
ADMIN_SERVICE_KEY=
CREW_SERVICE_URL=http://localhost:3002
# Para eliminar usuarios: Admin llama a sus rutas internas con token de servicio.
FLIGHTS_SERVICE_URL=http://localhost:3001
RECOMMENDATION_SERVICE_URL=http://localhost:3003
NOTIFICATION_SERVICE_URL=http://localhost:3004
# Quién envía los correos de invitación y recuperación: resend (por defecto), smtp o brevo.
EMAIL_PROVIDER=resend
# Resend: en modo de prueba solo entrega al correo del dueño de la cuenta de Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=AirCrew <onboarding@resend.dev>
# SMTP (p. ej. Gmail): llega a cualquier correo. SMTP_PASS es una contraseña de
# aplicación de Google (requiere la verificación en 2 pasos), no la de la cuenta.
# 465 con SMTP_SECURE=true; 587 (STARTTLS) con SMTP_SECURE=false.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Brevo (API HTTPS): llega a cualquier correo con un remitente verificado en Brevo.
# Úsalo donde el SMTP está bloqueado, como Railway en los planes Free, Trial y Hobby.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# Opcional: por defecto, AirCrew.
BREVO_SENDER_NAME=
# Página del frontend que activa la cuenta; el correo agrega ?token=...
CREW_ACTIVATION_URL=http://localhost:5173/activar-cuenta
# Minutos que sirve el enlace de activación (por defecto 1440, un día).
ACTIVATION_TOKEN_EXPIRES_MINUTES=1440
# Página del frontend que restablece la contraseña; el correo agrega ?token=...
PASSWORD_RESET_URL=http://localhost:5173/restablecer-contrasena
