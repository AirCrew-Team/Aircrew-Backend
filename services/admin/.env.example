PORT=3005
DB_HOST=localhost
DB_PORT=5432
DB_NAME=admin_db
DB_USER=postgres
DB_PASSWORD=
# Igual en todos los servicios: Admin firma los tokens y los demás los validan.
JWT_SECRET=
JWT_EXPIRES_IN=1h
# Clave para crear el primer super_admin (header x-bootstrap-key).
SUPER_ADMIN_BOOTSTRAP_KEY=
# Igual que en crew/.env: Crew la usa para pedir cuentas de tripulante.
CREW_SERVICE_KEY=
# Resend, para el correo de invitación a tripulantes.
RESEND_API_KEY=
RESEND_FROM_EMAIL=AirCrew <onboarding@resend.dev>
# Página del frontend que activa la cuenta; el correo agrega ?token=...
CREW_ACTIVATION_URL=http://localhost:5173/activar-cuenta
