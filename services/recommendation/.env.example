PORT=3003
JWT_SECRET=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=recommendation_db
DB_USER=postgres
DB_PASSWORD=
CREW_SERVICE_URL=http://localhost:3002
FLIGHTS_SERVICE_URL=http://localhost:3001
NOTIFICATION_SERVICE_URL=http://localhost:3004

# IA (Claude). Si falla o está apagada (AI_ENABLED=false), se usa el plan B: el orden por reglas.
AI_ENABLED=true
# claude_code: usa tu suscripción de Claude con Claude Code instalado
#   (npm install -g @anthropic-ai/claude-code) y el token de `claude setup-token`.
# api: usa la API de Anthropic con saldo (ANTHROPIC_API_KEY).
AI_PROVIDER=claude_code
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
