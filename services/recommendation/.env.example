PORT=3003
# Igual en todos los servicios: Admin firma los tokens y los demás los validan.
JWT_SECRET=
# No la definas: por defecto aircrew-admin, el emisor de los tokens de Admin.
# JWT_ISSUER=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=recommendation_db
DB_USER=postgres
DB_PASSWORD=
ADMIN_SERVICE_URL=http://localhost:3005
CREW_SERVICE_URL=http://localhost:3002
FLIGHTS_SERVICE_URL=http://localhost:3001
NOTIFICATION_SERVICE_URL=http://localhost:3004
# Cada cuánto se revisan los plazos de «Enterado» vencidos (ms).
DEADLINE_CHECK_MS=60000

# IA (Claude). Es obligatoria: si está apagada, sin configurar o no responde,
# las recomendaciones y sugerencias responden 503 y el servicio lo avisa al arrancar.
AI_ENABLED=true
# claude_code: usa la suscripción de Claude con Claude Code, que se instala con
#   el servicio (paquete @anthropic-ai/claude-code). Necesita el token de
#   suscripción de Claude Code en CLAUDE_CODE_OAUTH_TOKEN; sin él la IA queda apagada.
# api: usa la API de Anthropic con saldo (ANTHROPIC_API_KEY).
AI_PROVIDER=claude_code
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
# Opcional. Vacío: el modelo por defecto de Claude Code (con api, claude-opus-5-5).
CLAUDE_MODEL=
# Opcional. Tiempo máximo por llamada en ms (por defecto 90000 con claude_code y 20000 con api).
AI_TIMEOUT_MS=
# Opcional. Ruta de la CLI de Claude Code; vacío usa la del paquete instalado.
CLAUDE_CODE_PATH=
